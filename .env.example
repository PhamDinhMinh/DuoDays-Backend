# DuoDays backend – environment template.
# Copy to .env and fill in real values locally. NEVER commit .env or real secrets.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ── App ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=true

# ── Database (MongoDB Atlas) ──────────────────────────────
# mongodb+srv connection string for the development cluster (secret)
MONGODB_URI=
MONGODB_DB_NAME=duodays_dev

# ── Access token (JWT) ────────────────────────────────────
# At least 32 random bytes (secret)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_ISSUER=duodays-api
JWT_AUDIENCE=duodays-app

# ── Refresh token ─────────────────────────────────────────
# At least 32 random bytes, different from JWT_ACCESS_SECRET (secret)
REFRESH_TOKEN_PEPPER=
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=180

# ── Couples ───────────────────────────────────────────────
# How long an invite code stays usable after it is issued (1–168)
INVITE_TTL_HOURS=24

# ── Rate limiting (in-memory, single instance) ────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ── Social auth (later phase – leave empty) ───────────────
# Comma-separated iOS bundle ID(s)
APPLE_CLIENT_IDS=
# Comma-separated iOS + Android OAuth client IDs
GOOGLE_CLIENT_IDS=
